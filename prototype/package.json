{
  "name": "health-assistant-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "build:pages": "node build-pages.mjs",
    "watch": "node build.mjs --watch",
    "test:glass": "node --test tests/glass-scale.test.mjs",
    "check": "node --check server.mjs && node --check history-gesture.js && node --check src/data.js && npm run test:glass && npm run test:navigation && npm run test:preferences && npm run test:widget-day && npm run test:pulse && npm run test:mascot && npm run test:case && npm run build",
    "test:pulse": "node --test tests/pulse-chart.test.mjs",
    "test:widget-day": "node --test tests/widget-day.test.mjs",
    "test:preferences": "node --test tests/preferences.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:mascot": "node --test tests/mascot.test.mjs",
    "test:case": "node --experimental-strip-types --test tests/case.test.mjs"
  },
  "dependencies": {
    "@glass-sdk/liquid-glass": "0.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
